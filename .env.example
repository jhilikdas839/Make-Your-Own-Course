# Copy this file to ".env" and change the values for your setup.
# Never commit your real .env file.

# Backend API base URL
VITE_API_URL=https://makeyourowncoursbackend.onrender.com

# Show "Demo access" buttons (student / teacher / super admin) on the login page.
# Use "true" only for local development or demos.
VITE_ENABLE_DEMO_LOGIN=true
